# Copy to env/.env and fill in. env/.env is gitignored and must never be committed.
#
#     cp env/.env.example env/.env
#     python run.py brief --force
#
# ---------------------------------------------------------------- the brief
# Where the morning brief goes. This overrides founder_email in the vault's
# company/profile.md, which is how the committed demo vault is redirected to a
# real inbox without editing a tracked file.
FOUNDER_EMAIL=you@example.com

# Gmail: SMTP_USER is the account that SENDS, and SMTP_PASS is a 16-character
# App Password -- not the account password. An App Password requires 2-Step
# Verification to be switched on for that account first
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# Any other provider works too; only these four values change.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# With SMTP_HOST unset or unreachable, nothing is lost: the brief is rendered in
# full and written to <vault>/alerts/outbox/<date>-brief.txt instead.

# ------------------------------------------------------------------ bedrock
# Only needed for `run.py ask` and the AI commentary in the brief. Without it
# the board still renders and the brief still sends, with vault figures only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
